# ==============================================================================
# Flowify Monorepo - Environment Configuration Example
# Copy this file to .env in root or individual service directories as needed.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Used by: primary-backend, hooks, processor, workers
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowify?schema=public"

# Authentication & Security
# Used by: primary-backend
JWT_PASSWORD="your-secure-jwt-secret-here"

# Service Ports
PORT=3010
HOOKS_PORT=3011

# Kafka Message Broker
# Used by: processor, workers
KAFKA_BROKER="localhost:9092"
KAFKA_CLIENT_ID="outbox-processor"
KAFKA_TOPIC="zap-events"
KAFKA_CONSUMER_GROUP="flowify-worker-dev-v2"
# For Cloud Kafka (Upstash / Confluent / Aiven / AWS MSK):
# KAFKA_SSL="true"
# KAFKA_USERNAME="your-kafka-username"
# KAFKA_PASSWORD="your-kafka-password"
# KAFKA_SASL_MECHANISM="scram-sha-256" # or "plain"

# Notification Services (Nodemailer / Gmail)
# Used by: workers
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# Optional: WhatsApp / Twilio Integration
# TWILIO_ACCOUNT_SID="your-twilio-sid"
# TWILIO_AUTH_TOKEN="your-twilio-auth-token"

# Frontend Configuration
# Used by: flowify-frontend
NEXT_PUBLIC_BACKEND_URL="http://localhost:3010/api/v1"
NEXT_PUBLIC_HOOKS_URL="http://localhost:3011/hooks/catch"

