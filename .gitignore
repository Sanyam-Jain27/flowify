# ==============================================================================
# Flowify Monorepo - Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
packages/*/node_modules/
.pnp
.pnp.*

# Build Outputs & Compilations
dist/
*/dist/
build/
*/build/
.next/
flowify-frontend/.next/
out/
flowify-frontend/out/

# TypeScript Build Info
*.tsbuildinfo

# Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
flowify-frontend/.env*.local
*/.env
*/.env.*
!*/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Operating System & IDE Files
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Vercel & Turbo Cache
.vercel
.turbo

