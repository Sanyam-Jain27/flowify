# Build stage
FROM node:20-slim AS builder

WORKDIR /app

RUN apt-get update -y && apt-get install -y openssl ca-certificates

# Copy dependency manifests
COPY package*.json ./
COPY prisma ./prisma/
COPY packages/shared/package*.json ./packages/shared/
COPY primary-backend/package*.json ./primary-backend/
COPY hooks/package*.json ./hooks/
COPY processor/package*.json ./processor/
COPY workers/package*.json ./workers/

# Install dependencies and generate Prisma client
RUN npm install
RUN npx prisma generate

# Copy source code
COPY tsconfig.json ./
COPY packages ./packages
COPY primary-backend ./primary-backend

# Build backend and shared packages
RUN ./primary-backend/node_modules/.bin/tsc -b

# Production Runner stage
FROM node:20-slim AS runner
WORKDIR /app

RUN apt-get update -y && apt-get install -y openssl ca-certificates

ENV NODE_ENV=production
ENV PORT=3010

COPY --from=builder /app ./

EXPOSE 3010

CMD ["node", "primary-backend/dist/index.js"]
